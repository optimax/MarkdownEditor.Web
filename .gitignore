# MarkdownEditor.Web: plain JavaScript, no build step and no dependencies, so there is no
# build output to ignore; only what editors, tools and the operating system leave behind.

# Claude Code's local settings and its worktrees (its launch.json starts the server for
# Claude's browser)
.claude/

# Editors
.vs/
.vscode/
.idea/
*.suo
*.user
*.swp
*~

# Node, should a tool ever be run here (the project itself has no dependencies)
node_modules/
npm-debug.log*

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.orig

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
